# Python virtualenvs. Create them with `py -3.12 -m venv .venv`, NOT with a bare
# `python -m venv`: every Python job in .github/workflows/ci.yml pins 3.12, and a
# machine whose default interpreter is newer will happily run the suite green
# against stdlib behaviour CI does not have. `ipaddress` classifies IPv4-mapped
# IPv6 addresses differently before/after 3.13, which is exactly the kind of
# difference apps/auditor-api/ssrf_guard.py turns on.
.venv*/
venv/

# EVAL-3 ares-core scoring: local staging/output scratch, regenerated by
# eval/stage_ares_core_targets.py + `ares scan` -- eval/predictions/ares-latest.csv
# is NOT here, it's the intentional committed artifact CI scores against.
ares-eval-staging/
ares-output/

# Rust build output. Anchored to the repo root (leading slash) so it does NOT
# also ignore source directories named `target/` deeper in the tree — e.g.
# apps/ares-sec/src/target/, which was silently dropped from the SEC-1 import by
# the previous unanchored `target/` rule. The Rust engine's own build output is
# ignored by core/.gitignore.
/target/

# IDE / AI assistant local config
.vscode/
.devin/
.claude/
.windsurf/

# LangGraph API
.langgraph_api
