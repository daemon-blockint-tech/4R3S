# ARES environment — copy to `.env` and fill in. NEVER commit your real .env.
# At least one LLM provider key is required (OpenRouter is the default backbone).

# ── LLM providers (set the one(s) you use) ──
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VENICE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY=
TOGETHER_API_KEY=
HUGGINGFACE_TOKEN=
REPLICATE_API_TOKEN=

# ── GitHub (xbow-bench challenge fetch / gh operations) ──
GITHUB_TOKEN=

# ── optional: default backbone overrides ──
# LLM_PROVIDER=openrouter
# LLM_MODEL=claude-opus-4-8

# ── optional: LangSmith tracing (APAC — https://apac.smith.langchain.com) ──
# Read by src/tracing/ (LANGSMITH_* and legacy LANGCHAIN_* aliases below).
# LangGraph Studio loads ./.env via langgraph.json; start with: npm run langgraph:dev
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ares-sec
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
# Legacy aliases (optional; src/tracing/ honors these if LANGSMITH_* unset):
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=ares-sec
