{
  "name": "ares-agent",
  "version": "0.1.0",
  "private": true,
  "description": "ARES-AGENT: Solana audit platform with LangGraph + OpenRouter + Crystalline cognitive memory",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20",
    "npm": ">=11"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "audit": "tsx src/index.ts",
    "ares": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "ingest:solsec": "tsx src/scripts/ingest-solsec.ts",
    "eval:predict": "tsx src/scripts/eval-predict.ts",
    "export:vuln-catalog": "tsx src/scripts/export-vuln-catalog.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.14",
    "@langchain/langgraph-checkpoint": "^1.0.0",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@langchain/langgraph-cua": "^1.0.2",
    "@langchain/openai": "^1.5.11",
    "@langchain/openrouter": "^0.4.11",
    "@solana/web3.js": "^1.98.4",
    "@supabase/supabase-js": "^2.115.0",
    "bs58": "^6.0.0",
    "dotenv": "^17.4.2",
    "neo4j-driver": "^6.2.0",
    "pg": "^8.23.0",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^11.0.0",
    "eslint": "^10.10.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "uuid": "$uuid"
  }
}
