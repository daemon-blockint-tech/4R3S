# =============================================================================
# ARES Auditor — root `.env` (CLI agent at src/)
# Copy to `.env` and fill in secrets. Never commit `.env`.
# Dashboard env vars live in apps/auditor-web/.env.local — see docs/user/guides/dashboard.mdx
# =============================================================================

# --- OpenRouter / LLM (required) ------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_REFERRER=ares-agent
# Per-request deadline for LLM calls (ms). Report synthesis is the slowest phase.
# OPENROUTER_TIMEOUT_MS=120000

# --- Solana RPC -----------------------------------------------------------------
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_COMMITMENT=confirmed
# Optional Helius RPC — overrides SOLANA_RPC_URL for on-chain reads when set.
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=xxxxxxxx
# SOLANA_TIMEOUT_MS=15000

# --- Postgres (LangGraph checkpoint) --------------------------------------------
# Local Docker (`npm run db:up`):
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ares
POSTGRES_USER=ares
POSTGRES_PASSWORD=ares_dev_password
POSTGRES_SSL=false
# POSTGRES_TIMEOUT_MS=30000

# Supabase pooler example (same project as SUPABASE_URL below):
# POSTGRES_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# POSTGRES_PORT=5432
# POSTGRES_DB=postgres
# POSTGRES_USER=postgres.<project-ref>
# POSTGRES_PASSWORD=your-db-password
# POSTGRES_SSL=true
# URL-encode `#` in passwords as %23 if you build a connection string manually.

# --- Supabase (hybrid keyword + vector retrieval) — OPTIONAL --------------------
# When unset, recall falls back to Crystalline-only. Apply migrations in order:
#   db/supabase/0001_hybrid_search.sql
#   db/supabase/0002_rbac.sql
#   db/supabase/0003_data_api_security.sql
# Enable custom_access_token_hook in Dashboard → Authentication → Hooks.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxx
# Server-side only — never expose in browser or auditor-web client bundles.
# SUPABASE_TIMEOUT_MS=15000

# Browser Auth (GitHub / Web3 via Supabase) — set in apps/auditor-web/.env.local, not here:
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxx

# --- Neo4j (graph expansion) — OPTIONAL -----------------------------------------
# Local: `npm run db:up`. Aura: use neo4j+s:// URI from console.neo4j.io
# ARES reads NEO4J_USER (not NEO4J_USERNAME — rename if copying Aura .env).
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=ares_dev_password
# NEO4J_TIMEOUT_MS=15000

# --- Embeddings (OpenAI-compatible) — OPTIONAL ----------------------------------
# Required for semantic search + ingest; recall degrades to lexical without it.
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_API_KEY=sk-xxxxxxxx
EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_DIM=1536
# EMBEDDINGS_TIMEOUT_MS=15000

# --- Knowledge base ingest ------------------------------------------------------
SOLSEC_REPO_URL=https://github.com/sannykim/solsec.git

# --- Semgrep (static analyzer) — OPTIONAL local binary --------------------------
# Install: pipx install semgrep
# SEMGREP_BIN=semgrep
# SEMGREP_TIMEOUT_MS=120000

# --- Computer Use Agent (CUA) — OPTIONAL, opt-in --------------------------------
# Pass --cua or set CUA_ENABLED=true. Requires BOTH keys below.
# CUA uses OpenAI computer-use-preview directly — NOT via OpenRouter.
# OPENAI_API_KEY=sk-xxxxxxxx
# SCRAPYBARA_API_KEY=scrapy-xxxxxxxx
CUA_ENABLED=false
CUA_ENVIRONMENT=web
CUA_TIMEOUT_HOURS=1
CUA_RECURSION_LIMIT=100

# --- ARES runtime ---------------------------------------------------------------
ARES_MAX_ITERATIONS=12
ARES_LOG_LEVEL=info
# Max characters loaded from source tree into analyzer context.
# ARES_SOURCE_BUDGET_CHARS=120000
# Pin checkpoint thread id (unset = one thread per audit target).
# ARES_THREAD_ID=

# --- LangSmith tracing — OPTIONAL (LangGraph / LangChain auto-detect) -----------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=4R3S
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Legacy alias: LANGCHAIN_TRACING_V2=true

# --- Billing / monetization — OPTIONAL, opt-in ----------------------------------
# With BILLING_ENABLED unset, ARES does no metering or settlement.
# BILLING_ENABLED=false
# BILLING_CREDIT_USD=0.01
# BILLING_MARKUP=1.3
# BILLING_MIN_MARGIN_PCT=0.2
# BILLING_MIN_CHARGE_CREDITS=1
# BILLING_PLAN_CREDITS=0
# BILLING_ONDEMAND_ENABLED=false
# BILLING_ONDEMAND_LIMIT_CREDITS=
# BILLING_ACCOUNT_STORE_PATH=
# MPP_ENDPOINT=
# MPP_PAYER_ID=ares-agent
# MPP_ALLOW_LOCAL_FALLBACK=false
